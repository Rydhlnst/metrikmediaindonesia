# ==============================================================================
# METRIK MEDIA INDONESIA - ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================

# Application URL & Auth
DOMAIN=metrikmediaindonesia.id
NEXT_PUBLIC_APP_URL=http://localhost:3000
BETTER_AUTH_SECRET=generate_a_random_32_character_secret_here

# Database Configuration (PostgreSQL)
DATABASE_TYPE=postgresql
POSTGRES_DB=metrikmedia
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/metrikmedia

# MinIO / S3 Object Storage
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=metrikmedia
MINIO_USE_SSL=false
MINIO_PUBLIC_URL=http://localhost:9000

# Redis Cache
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379
