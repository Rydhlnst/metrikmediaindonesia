# ==============================================================================
# METRIK MEDIA INDONESIA - ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================

# Application URL & Auth
DOMAIN=metrikmediaindonesia.id
NEXT_PUBLIC_APP_URL=http://localhost:3000
BETTER_AUTH_SECRET=generate_a_random_32_character_secret_here
CRON_SECRET=generate_a_second_random_32_character_secret_here
TRUST_PROXY_HEADERS=true

# Email delivery (configure one provider in production)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=no-reply@metrikmediaindonesia.id
EDITORIAL_EMAIL=editorial@metrikmediaindonesia.id

# Resend API (alternative to SMTP)
RESEND_API_KEY=

# Database Configuration (PostgreSQL)
DATABASE_TYPE=postgresql
POSTGRES_DB=metrikmedia
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_PORT=5432
POSTGRES_URL=postgresql://postgres:change_me_in_production@localhost:5432/metrikmedia

# MinIO / S3 Object Storage
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_in_production
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change_me_in_production
MINIO_BUCKET=metrikmedia
MINIO_USE_SSL=false
MINIO_PUBLIC_URL=http://localhost:9000

# Redis Cache
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379
