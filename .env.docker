# ==============================================================================
# METRIK MEDIA INDONESIA - DOCKER ALL-IN-ONE ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application Domain & Base URLs
DOMAIN=metrikmediaindonesia.id
NEXT_PUBLIC_APP_URL=https://metrikmediaindonesia.id
BETTER_AUTH_SECRET=super_secret_better_auth_token_change_in_production_xyz123

# Database Selection (postgresql / mysql)
DATABASE_TYPE=postgresql

# PostgreSQL Configuration
POSTGRES_DB=metrikmedia
POSTGRES_USER=postgres
POSTGRES_PASSWORD=metrikmedia_db_secure_password_2026
POSTGRES_PORT=5432
POSTGRES_URL=postgresql://postgres:metrikmedia_db_secure_password_2026@postgres:5432/metrikmedia

# MinIO / S3 Object Storage Configuration
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minio_storage_secure_password_2026
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minio_storage_secure_password_2026
MINIO_BUCKET=metrikmedia
MINIO_USE_SSL=false

# Public Storage URL accessed by visitors' browsers
# In single-server setup with reverse proxy:
# Option A (Subpath): https://metrikmediaindonesia.id/storage
# Option B (Subdomain): https://storage.metrikmediaindonesia.id
# Option C (Local Dev): http://localhost:9000
MINIO_PUBLIC_URL=https://metrikmediaindonesia.id/storage

# Redis Cache
REDIS_PORT=6379
REDIS_URL=redis://redis:6379
