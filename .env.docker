# ==============================================================================
# METRIK MEDIA INDONESIA - DOCKER ALL-IN-ONE ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application Domain & Base URLs
NODE_ENV=development
DOMAIN=localhost
NEXT_PUBLIC_APP_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=local_better_auth_secret_change_me
CRON_SECRET=local_cron_secret_change_me
TRUST_PROXY_HEADERS=false

# Database Selection (postgresql / mysql)
DATABASE_TYPE=postgresql

# PostgreSQL Configuration
POSTGRES_DB=metrikmedia
POSTGRES_USER=postgres
POSTGRES_PASSWORD=local_postgres_password
POSTGRES_PORT=5432
POSTGRES_URL=postgresql://postgres:local_postgres_password@postgres:5432/metrikmedia

# MinIO / S3 Object Storage Configuration
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=local_minio_password
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=local_minio_password
MINIO_BUCKET=metrikmedia
MINIO_USE_SSL=false

# Email delivery (required in production)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
RESEND_API_KEY=

# Public Storage URL accessed by visitors' browsers
# In single-server setup with reverse proxy:
# Option A (Subpath): https://metrikmediaindonesia.id/storage
# Option B (Subdomain): https://storage.metrikmediaindonesia.id
# Option C (Local Dev): http://localhost:9000
MINIO_PUBLIC_URL=http://localhost:9000

# Redis Cache
REDIS_PORT=6379
REDIS_URL=redis://redis:6379
